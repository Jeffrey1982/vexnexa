{
  "name": "vexnexa",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app studio proxy.ts next.config.js playwright.config.ts vitest.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:local": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "node --test scripts/production-smoke.test.mjs",
    "test:all": "npm run test:coverage && npm run build && npm run test:e2e",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "lucide-react": "^0.542.0",
    "next": "^16.3.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "resend": "^6.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.3",
    "jsdom": "^27.3.0",
    "sharp": "^0.35.4",
    "typescript": "^5.6.2",
    "vitest": "4.0.18"
  }
}
