# VexNexa Game Studio. Copy to .env.local; never commit real credentials.
# Optional for local public pages; required for production contact email.
RESEND_API_KEY=""

# An address on a domain verified in Resend; this is NOT an API key.
RESEND_ADMIN_FROM_EMAIL="VexNexa Games <updates@vexnexa.com>"

# Compatibility fallback when RESEND_ADMIN_FROM_EMAIL is absent:
# RESEND_FROM_EMAIL="VexNexa Games <updates@vexnexa.com>"

# No Supabase, Prisma, Mollie, analytics, AI or cron credentials are needed.
